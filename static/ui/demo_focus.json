    { "type": "particle_population", "params": ["*"] },
    { "type": "render_item_particles", "params": ["size", "opacity"] },
    { "type": "render_item_particle_trails", "params": ["trail_length", "opacity"] },
    { "type": "render_item_field_lines", "params": ["opacity"] }
